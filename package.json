{
  "name": "dsh-qqterm",
  "version": "0.0.1",
  "icon": "./assets/icons/qq_logo.svg",
  "description": "QQ 超级终端：在 QQ 私聊里操作 DeepSeek Harness。 QQ SuperTerm: operate DeepSeek Harness from QQ private chats.",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc && tsdown --config tsdown.client.config.ts",
    "build:client": "tsdown --config tsdown.client.config.ts",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "lint": "eslint src/",
    "test": "vitest run",
    "dev:reload": "node scripts/dev-reload.mjs",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "clean": "rm -rf dist lib",
    "ci:prepare-test-pkg": "node scripts/prepare-test-pkg.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "qqterm",
    "superterm",
    "terminal",
    "qqbot",
    "qq",
    "cordis",
    "plugin",
    "chatbot",
    "im"
  ],
  "license": "MIT",
  "author": "xiaotian86www <xiaotian86www@163.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaotian86www/dsh-qqbot.git"
  },
  "homepage": "https://github.com/xiaotian86www/dsh-qqbot#readme",
  "bugs": {
    "url": "https://github.com/xiaotian86www/dsh-qqbot/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "lib",
    "locale",
    "assets",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "CHANGELOG.md",
    "CHANGELOG_EN.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible"
      },
      "note": "0.2.2-rc.1 为当前唯一验收版本：插件硬依赖 agents / llm / agentDefaultModel / sessionProjections / sessionPersistence / sessionQuery / sessionTitle / permissionPresets / settings / commands / tools / attachments / workingDirectory / pluginManager（14 项全部写入 inject），缺任一服务插件不激活。agentPresets / webServer / workspaceRegistry 不进 inject，按部署可选：缺 agentPresets 时 /preset 不注册，缺 webServer 时绑定只走终端 / 浏览器，缺 workspaceRegistry 时 /sessions 仅按目录分组且不给归档入口。sessionController 只在 adapter 中软读一次 list()，供 /sessions 的排序与空白会话标记。compaction 由会话绑定的 agent preset 提供，不进 inject，/compact 也不从宿主面取引擎。客户端依赖 settings.section 席位契约与 dsh.client 模块系统，宿主大版本升级后请重新验收席位行为。"
    }
  },
  "dependencies": {
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "^1.0.5",
    "js-yaml": "^4.1.0",
    "qrcode": "^1.5.4",
    "yaml": "2.8.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-agent": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": ">=0.1.0-rc.6",
    "@deepseek-ai/schemastery": ">=3.18.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": false
    },
    "@deepseek-ai/schemastery": {
      "optional": false
    },
    "@deepseek-ai/dsh-agent": {
      "optional": false
    },
    "@deepseek-ai/dsh-session": {
      "optional": false
    },
    "@deepseek-ai/dsh-llm": {
      "optional": false
    },
    "@deepseek-ai/dsh-user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-approval": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.5.0",
    "vitest": "^4.1.8"
  }
}
